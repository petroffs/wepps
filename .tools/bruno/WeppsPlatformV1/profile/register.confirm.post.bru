meta {
  name: POST register.confirm
  type: http
  seq: 3
}

post {
  url: {{base_url}}/rest/v1/register.confirm
  body: json
  auth: none
}

body:json {
  {
    "data": {
      "token": "{{reg_token}}",
      "password": "{{reg_password}}",
      "password2": "{{reg_password}}"
    }
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.body?.data;
    if (data?.access_token)  bru.setVar("access_token",  data.access_token);
    if (data?.refresh_token) bru.setVar("refresh_token", data.refresh_token);
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("response has access_token", function() {
    expect(res.body.data).to.have.property("access_token");
  });
  test("response has refresh_token", function() {
    expect(res.body.data).to.have.property("refresh_token");
  });
  test("save access_token", function() {
    bru.setVar("access_token", res.body.data.access_token);
  });
  test("save refresh_token", function() {
    bru.setVar("refresh_token", res.body.data.refresh_token);
  });
}

docs {
  Confirm registration via token from email link.
  Send token from email link, password and password2.
  On success account is created and access+refresh tokens are returned.
}
