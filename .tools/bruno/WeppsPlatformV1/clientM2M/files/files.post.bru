post {
  url: {{base_url}}/rest/m2m/goods.images
  body: json
  auth: inherit
}

body:json {
  {
    "data": [
      {
        "guid": "8b411621-7e3a-11f1-85a7-4ccc6ad9349d",
        "name": "test.jpg",
        "list": "Products",
        "listField": "ImagesV",
        "listId": 326,
        "description": "Черный",
        "filter": "Черный",
        "url": "/files/lists/Products/000326_ImagesV_1778280429_B01.jpg",
        "base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
      }
