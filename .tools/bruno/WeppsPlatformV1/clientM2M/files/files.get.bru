meta {
  name: GET files
  type: http
  seq: 1
}

get {
  url: {{base_url}}/rest/m2m/files?page=1&limit=100&list=Products&listId={{goods_id}}
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 100
  list: Products
  listId: {{goods_id}}
  ~filter: Синий
  ~listField: Images
}

settings {
  encodeUrl: true
  timeout: 0
}
