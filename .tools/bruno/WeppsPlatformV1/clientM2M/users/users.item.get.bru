meta {
  name: GET users.item
  type: http
  seq: 2
}

get {
  url: {{base_url}}/rest/m2m/users.item?id={{user_id}}
  body: none
  auth: inherit
}

params:query {
  id: {{user_id}}
}


tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("data has id", function() {
    expect(res.body.data).to.have.property("id");
  });
  test("data has login", function() {
    expect(res.body.data).to.have.property("login");
  });
}

docs {
  Get single user by id.
  Доступно только для M2M клиентов.
}
