meta {
  name: POST users
  type: http
  seq: 3
}

post {
  url: {{base_url}}/rest/m2m/users
  body: json
  auth: inherit
}

body:json {
  {
    "data": [
      {
        "guid": "1ca68e27-7b14-11f1-a44e-4ccc6ad9349d",
        "name": "weppsadmin1",
        "nameFirst": "Admin1",
        "nameSurname": "Wepps1",
        "login": "admin1@wepps.loc",
        "email": "admin1@wepps.loc",
        "phone": "79001234568"
      }
    ],
    "pagination": {
      "count": 1,
      "limit": 100,
      "page": 1
    }
  }
}

docs {
  Создание пользователя(ей).
  Доступно только для M2M клиентов.
  
  Одна запись: { "data": { ... } }  → status 201
  Batch:       { "data": [ { ... }, { ... } ] }  → status 207 (макс. 100)
  
  Массовое скрытие через пагинацию:
  { "data": [...], "pagination": { "count": N, "page": 1 } }
  - page=1: все существующие пользователи помечаются IsHiddenCandidate=1
  - каждая страница: сбрасывает флаг для созданных id
  - последняя страница (page === count): финализирует IsHidden = IsHiddenCandidate
  
  Без pagination — только создание записей (без массового скрытия).
}
