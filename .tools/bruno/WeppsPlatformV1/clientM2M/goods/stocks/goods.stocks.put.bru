meta {
  name: PUT goods.stocks
  type: http
  seq: 2
}

put {
  url: {{base_url}}/rest/m2m/goods.stocks
  body: json
  auth: inherit
}

body:json {
  {
    "data": [
      {
        "id": 2081,
        "stocks": 96
      },
      {
        "id": 2082,
        "stocks": 91
      }
    ],
    "pagination": {
      "count": 1,
      "limit": 20,
      "page": 1
    }
  }
}

tests {
  test("status 200 or 207", function() {
    expect([200, 207]).to.include(res.status);
  });
  test("data is array", function() {
    expect(res.body.data).to.be.an('array');
  });
  test("each item has status", function() {
    res.body.data.forEach(item => {
      expect(item.status).to.be.a('number');
    });
  });
}

docs {
  Обновление остатков вариаций по их ID.
  
  Полная перезагрузка остатков (пакетная синхронизация):
  { "data": [...], "pagination": { "count": N, "page": 1 } }
  - page=1: ВСЕ остатки обнуляются (Field4 = 0)
  - затем обновлённые id получают новые значения stocks
  
  Без pagination — только точечное обновление переданных id (без обнуления).
  
  Одна вариация: { "data": { "id": 2081, "stocks": 96 } }  → status 200
  Batch:         { "data": [ { "id": 2081, "stocks": 96 }, { "id": 2082, ... } ] }  → status 207
  
  ID передаётся только в теле {"id": 123}; через GET параметр ?id= не поддерживается.
  
  Обязательные поля:
  - id — ID вариации (ProductsVariations)
  - stocks — количество (Field4)
  
  Ответ на успешное обновление (одиночный):
  { "status": 200, "message": "Updated", "data": null }
  
  Ответ на batch:
  { "status": 207, "message": "Multi-Status", "data": [ { "status": 200, ... }, ... ] }
}
