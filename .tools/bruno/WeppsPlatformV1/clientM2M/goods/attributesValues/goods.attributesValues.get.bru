meta {
  name: GET goods.attributesValues
  type: http
  seq: 1
}

get {
  url: {{base_url}}/rest/m2m/goods.attributesValues
  body: none
  auth: inherit
}

params:query {
  ~listId: {{goods_id}}
  ~listField: PCategory
  ~list: Products
  ~page: 1
  ~limit: 2
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("data is array", function() {
    expect(res.body.data).to.be.an("array");
  });
}

docs {
  GET /rest/m2m/goods.attributesValues — значения свойств товаров (s_PropertiesValues).
  Доступно только для M2M клиентов.
  
  Параметры (опциональные): page, limit, list (TableName), listId (TableNameId), listField (TableNameField)
  
  Возвращает список значений свойств:
  id, guidSync, name, alias, tableName, tableNameId, tableNameField, pValue.
  Сортировка по Priority asc.
}
