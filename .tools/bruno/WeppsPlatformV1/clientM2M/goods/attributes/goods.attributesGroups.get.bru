meta {
  name: GET goods.attributesGroups
  type: http
  seq: 2
}

get {
  url: {{base_url}}/rest/m2m/goods.attributesGroups
  body: none
  auth: inherit
}

params:query {
  ~page: 1
  ~limit: 100
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("data is array", function() {
    expect(res.body.data).to.be.an("array");
  });
}

docs {
  GET /rest/m2m/goods.attributesGroups — группы свойств товаров (s_PropertiesGroups).
  Доступно только для M2M клиентов.
  
  Параметры (опциональные): page, limit
  
  Возвращает список групп свойств: id, guid, name, alias, priority.
  Сортировка по Priority asc.
}
