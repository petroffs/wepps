meta {
  name: PUT goods.attributes
  type: http
  seq: 4
}

put {
  url: {{base_url}}/rest/m2m/goods.attributes
  body: json
  auth: inherit
}

body:json {
  {
    "data": [
      {
        "id": 6,
        "name": "Бренд-6",
        "priority": 50,
        "group": 1
      }
    ],
    "pagination": {
      "count": 1,
      "limit": 100,
      "page": 1
    }
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
}

docs {
  Обновление свойства(й) товаров по id.
  Доступно только для M2M клиентов.
  
  Одна запись: { "data": { "id": 6, "name": "Бренд-6" } }  → status 200
  Batch:       { "data": [ { "id": 6, ... }, { "id": 7, ... } ] }  → status 207
  
  Массовое скрытие через пагинацию:
  { "data": [...], "pagination": { "count": N, "page": 1 } }
  - page=1: все свойства помечаются IsHiddenCandidate=1
  - каждая страница: сбрасывает флаг для переданных id
  - последняя страница (page === count): финализирует IsHidden = IsHiddenCandidate
  
  Без pagination — только обновление переданных записей (без массового скрытия).
}
