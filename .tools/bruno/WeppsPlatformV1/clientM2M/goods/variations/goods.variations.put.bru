meta {
  name: PUT goods.variations
  type: http
  seq: 8
}

put {
  url: {{base_url}}/rest/m2m/goods.variations
  body: json
  auth: inherit
}

body:json {
  {
    "data": [
      {
        "id": 2104,
        "color": "Красный",
        "size": "42",
        "sku": "S001-КРА-42"
      },
      {
        "id": 2105,
        "guid": "5514fb1b-8a9c-11f1-bd9c-00155d49e9b9",
        "color": "Синий",
        "size": "44",
        "sku": "S001-СИН-44"
      }
    ],
    "pagination": {
      "count": 1,
      "limit": 20,
      "page": 1
    }
  }
}

tests {
  test("status 200 or 207", function() {
    expect([200, 207]).to.include(res.status);
  });
  test("data is array", function() {
    expect(res.body.data).to.be.an('array');
  });
  test("each item has status", function() {
    res.body.data.forEach(item => {
      expect(item.status).to.be.a('number');
    });
  });
}

docs {
  Обновление вариаций по их ID.
  
  Массовое скрытие через пагинацию:
  { "data": [...], "pagination": { "count": N, "page": 1 } }
  - page=1: все вариации помечаются IsHiddenCandidate=1
  - каждая страница: сбрасывает флаг для переданных id
  - последняя страница (page === count): финализирует IsHidden = IsHiddenCandidate
  
  Без pagination обновляются только переданные вариации (без массового скрытия).
  
  Одна вариация: { "data": { "id": 1, "color": "Синий", "size": "44", "sku": "S001-СИН-44" } }  → status 200
  Batch:         { "data": [ { "id": 1, ... }, { "id": 2, ... } ] }  → status 207
  
  ID передаётся только в теле {"id": 123}; через GET параметр ?id= не поддерживается.
  
  Обязательные поля:
  - id — ID вариации
  
  Опциональные поля:
  - color — цвет (Field1)
  - size  — размер (Field2)
  - sku   — артикул (Field3)
  - goodsId — ID товара
  - guid — уникальный GUID
  - priority — приоритет сортировки
  - isHidden — скрыть (0/1)
  
  Ответ на успешное обновление (одиночный):
  { "status": 200, "message": "Updated", "data": null }
  
  Ответ на batch:
  { "status": 207, "message": "Multi-Status", "data": [ { "status": 200, ... }, ... ] }
}
