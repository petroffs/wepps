meta {
  name: POST goods
  type: http
  seq: 2
  tags: [
    manual
  ]
}

post {
  url: {{base_url}}/rest/m2m/goods
  body: json
  auth: inherit
}

body:json {
  {
      "data": [
          {
              "guid": "04034dad-8e67-11f1-b258-00155df337c8",
              "name": "Свитер Wistedi-abcd",
              "alias": "sviter-wistedi-722-abcd",
              "navigatorId": "8",
              "price": "17450.00"
          }
      ]
  }
}

tests {
  test("status 201 or 207", function() {
    expect([201, 207]).to.include(res.status);
  });
  test("returns created id", function() {
    expect(res.body.data).to.have.property("id");
  });
}

docs {
  Create a new goods item.
  Доступно только для M2M клиентов.
  Эндпоинт настроен как 'async' => true — запрос ставится в очередь s_Tasks,
  сразу возвращает 202 Accepted с task_id, а результат получается через
  GET /rest/m2m/tasks.result?id={task_id} (is_processed: true → data).
  
  Обязательные поля:
  - guid — уникальный GUID записи
  - name — название товара
  - alias — алиас (URL-часть)
  - navigatorId — категория/NavigatorId
  - price — цена товара
  
  Опциональные поля:
  - article, descr, isHidden, priceBefore, status, metaTitle,
    metaDescription, metaKeyword, weightPack, displayFirst
  
  Одна запись: { "data": { ... } }  → status 201
  Batch:       { "data": [ { ... }, ... ] } (макс. 100) → status 207
  
  Возвращает id созданного товара.
}
