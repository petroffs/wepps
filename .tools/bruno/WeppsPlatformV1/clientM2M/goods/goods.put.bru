meta {
  name: PUT goods
  type: http
  seq: 3
  tags: [
    manual
  ]
}

put {
  url: {{base_url}}/rest/m2m/goods
  body: json
  auth: inherit
}

body:json {
  {
      "data": [
          {
              "id": 722,
              "name": "Свитер Wistedi-abc",
              "alias": "sviter-wistedi-722-abc"
          }
      ],
      "pagination": {
          "page": 1,
          "limit": 1,
          "count": 1
      }
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
}

docs {
  Update goods item by id.
  Доступно только для M2M клиентов.
  
  id — идентификатор товара (обязательно).
  name — новое название (необязательно).
  price — новая цена (необязательно).
  
  Можно обновлять отдельные поля.
  
  Массовое скрытие через пагинацию:
  { "data": [...], "pagination": { "count": N, "page": 1 } }
  - page=1: все товары помечаются IsHiddenCandidate=1
  - каждая страница: сбрасывает флаг для переданных id
  - последняя страница (page === count): финализирует IsHidden = IsHiddenCandidate
  
  Без pagination обновляются только переданные записи (без массового скрытия).
}
